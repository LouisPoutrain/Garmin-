# ==============================================================================
# Garmin MCP Server Configuration
# ==============================================================================
# Copiez ce fichier en '.env' et configurez vos identifiants si nécessaire :
#   cp .env.example .env
#
# Note de sécurité :
# Si vous utilisez l'authentification préalable avec la commande :
#   uv run garmin-mcp-auth
# Vos jetons OAuth sont sauvegardés dans ~/.garminconnect. Vous n'avez PAS besoin
# de renseigner GARMIN_EMAIL ni GARMIN_PASSWORD.
# ==============================================================================

# Identifiants Garmin Connect (facultatif si vous utilisez garmin-mcp-auth)
# GARMIN_EMAIL=votre_email@example.com
# GARMIN_PASSWORD=votre_mot_de_passe

# Chemin personnalisé pour le stockage des tokens (défaut : ~/.garminconnect)
# GARMINTOKENS=~/.garminconnect

# Spécifique Chine (garmin.cn) : true/false (défaut : false)
# GARMIN_IS_CN=false

# ==============================================================================
# Options de transport MCP
# ==============================================================================
# Transport : 'stdio' (défaut pour clients locaux comme Claude), 'streamable-http', ou 'sse'
# GARMIN_MCP_TRANSPORT=stdio

# Hôte et port pour le transport HTTP
# GARMIN_MCP_HOST=127.0.0.1
# GARMIN_MCP_PORT=8000

# Mode HTTP sans session (recommandé pour déploiements distants)
# GARMIN_MCP_STATELESS_HTTP=false

# Timeout par appel API Garmin en secondes (défaut : 90.0)
# GARMIN_MCP_CALL_TIMEOUT=90.0

# Répertoire de téléchargement des fichiers d'activités (.fit, .gpx, etc.)
# GARMIN_FIT_DOWNLOAD_DIR=~/Downloads/garmin

# ==============================================================================
# Filtrage des outils exposés (optionnel, pour alléger le contexte LLM)
# ==============================================================================
# Liste blanche d'outils autorisés (séparés par des virgules) :
# GARMIN_ENABLED_TOOLS=get_activities,get_stats,get_sleep_data,get_heart_rates

# Liste noire d'outils ignorés (séparés par des virgules) :
# GARMIN_DISABLED_TOOLS=delete_activity,delete_workout
